@startuml
' ЛР 12. Диаграмма классов проектирования (упрощённая: только основные классы предметной области).
' Атрибуты закрыты (-), операции открыты (+). Типы — понятия предметной области.
' Каждая связь имеет имя и кратности на обоих концах.
!include _style.iuml
title Диаграмма классов системы «КосмоДино»
hide circle
hide empty members
skinparam nodesep 60
skinparam ranksep 70
skinparam ClassFontSize 16
skinparam ClassAttributeFontSize 15
skinparam ArrowFontSize 14

enum Роль <<enumeration>> {
  читатель
  редактор
  администратор
}

enum СостояниеСтатьи <<enumeration>> {
  черновик
  на рецензии
  опубликована
  отклонена
  в архиве
}

class Пользователь {
  - логин : Строка
  - роль : Роль
  + войти(пароль : Строка)
}

class Раздел {
  - название : Строка
}

class Категория {
  - название : Строка
}

class Статья {
  - заголовок : Строка
  - текст : Текст
  - состояние : СостояниеСтатьи
  + отправитьНаРецензию()
  + опубликовать()
  + отклонить(замечание : Строка)
}

class Ревизия {
  - текст : Текст
  - дата : Дата
}

class Комментарий {
  - текст : Строка
  - дата : Дата
}

class Тег {
  - название : Строка
}

class ВопросВикторины {
  - формулировка : Строка
  + проверитьОтвет(вариант : Целое) : Логический
}

Раздел "1" *-- "1..*" Категория : содержит >
Категория "1" -- "0..*" Статья : классифицирует >
Пользователь "1" -- "0..*" Статья : пишет >
Пользователь "1" -- "0..*" Комментарий : оставляет >
Статья "1" *-- "1..*" Ревизия : хранит >
Статья "1" *-- "0..*" Комментарий : обсуждается в >
Статья "1" *-- "0..*" ВопросВикторины : проверяется >
Статья "0..*" o-- "0..*" Тег : помечена >
Пользователь ..> Роль
Статья ..> СостояниеСтатьи
@enduml
