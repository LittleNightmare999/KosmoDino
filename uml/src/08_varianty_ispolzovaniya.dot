// ЛР 11. Диаграмма вариантов использования (UML). Горизонтальная раскладка с ручными координатами:
// Фигурки актёров (UML) дорисовываются при конвертации в PNG над подписью узла с классом actor.
// актёры снаружи границы системы, рядом со своими вариантами; у каждой связи подписан её вид.
// Связь актёра с вариантом — сплошная линия без стрелки (ассоциация);
// обобщение — сплошная линия с незакрашенным треугольником у общего элемента;
// «include» — пунктир от базового варианта к включаемому; «extend» — пунктир от расширяющего к базовому.
digraph usecases {
  graph [layout=neato, splines=false, overlap=true, outputorder=nodesfirst,
         fontname="DejaVu Sans", fontsize=20, labelloc=t, pad=0.35,
         label="Диаграмма вариантов использования системы «КосмоДино»"];
  node  [fontname="DejaVu Sans", fontsize=12, shape=ellipse, style=filled, fillcolor="#EEEEEE",
         color="#222222", penwidth=1.4, width=2.2, height=0.7, fixedsize=true];
  edge  [fontname="DejaVu Sans", fontsize=10, fontcolor="#333333", color="#222222", penwidth=1.2, arrowsize=0.9];

  // граница системы
  boundary [shape=box, style="", fillcolor="", width=13.61, height=10.17, pos="8.692,4.305!", penwidth=1.6,
            labelloc=t, fontsize=15, label=<<B>Интерактивная энциклопедия «КосмоДино»</B>>];

  // актёры
  node [shape=plaintext, style="", width=1.3, height=1.25, fixedsize=true, fontsize=13, class="actor"];
  guest  [pos="0.000,7.708!",   label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="44" HEIGHT="74"> </TD></TR><TR><TD>Гость</TD></TR></TABLE>>];
  reader [pos="0.000,1.435!",  label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="44" HEIGHT="74"> </TD></TR><TR><TD>Читатель</TD></TR></TABLE>>];
  admin  [pos="17.548,6.560!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="44" HEIGHT="74"> </TD></TR><TR><TD>Администратор</TD></TR></TABLE>>];
  editor [pos="17.548,1.845!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD WIDTH="44" HEIGHT="74"> </TD></TR><TR><TD>Редактор</TD></TR></TABLE>>];

  // варианты гостя (левый столбец, верх)
  node [shape=ellipse, style=filled, width=2.2, height=0.7, fixedsize=true, fontsize=12, class=""];
  g_reg   [pos="3.690,8.774!", label="Зарегистрироваться"];
  g_login [pos="3.690,7.872!",  label="Войти в систему"];
  g_read  [pos="3.690,6.970!",  label="Прочитать статью\nс карточкой фактов"];
  g_time  [pos="3.690,6.068!",  label="Изучить\nхронологию"];
  g_graph [pos="3.690,5.166!",  label="Исследовать\nграф связей"];
  g_find  [pos="3.690,4.100!",  label="Найти статью"];
  g_text  [pos="6.560,4.592!",  label="Искать по тексту\nс учётом словоформ"];
  g_filt  [pos="6.560,3.608!",  label="Фильтровать по\nкатегории и тегу"];

  // варианты читателя (левый столбец, низ)
  r_com   [pos="3.690,2.788!",  label="Прокомментировать\nстатью"];
  r_bm    [pos="3.690,1.886!",  label="Вести закладки"];
  r_prof  [pos="3.690,0.984!",  label="Изменить профиль\nи пароль"];
  r_quiz  [pos="6.560,1.435!",  label="Пройти викторину"];
  r_save  [pos="6.560,0.287!",  label="Сохранить результат\nвикторины"];

  // варианты администратора (правый столбец, верх)
  a_rev   [pos="13.858,8.774!", label="Рецензировать\nстатью"];
  a_arch  [pos="13.858,7.872!",  label="Архивировать\nили удалить статью"];
  a_mod   [pos="13.858,6.970!",  label="Модерировать\nкомментарии"];
  a_role  [pos="13.858,6.068!",  label="Управлять ролями\nпользователей"];
  a_cat   [pos="13.858,5.166!",  label="Вести справочник\nкатегорий"];
  a_stat  [pos="13.858,4.264!",  label="Просмотреть журнал\nи статистику"];
  a_why   [pos="10.0,8.7!", label="Указать причину\nотклонения"];
  a_log   [pos="10.824,7.052!",  label="Записать действие\nв журнал"];

  // варианты редактора (правый столбец, низ)
  e_edit  [pos="13.858,3.198!",  label="Создать или\nправить статью"];
  e_send  [pos="13.858,2.296!",  label="Отправить статью\nна рецензию"];
  e_link  [pos="13.858,1.394!",  label="Связать статьи\nи добавить вопросы"];
  e_hist  [pos="13.858,0.492!",  label="Просмотреть\nисторию правок"];
  e_rev   [pos="10.824,2.747!", label="Сохранить ревизию"];

  // условные обозначения в свободной середине
  legend [pos="8.9,5.75!", shape=plaintext, style="", fixedsize=false, fontsize=11, label=<
    <TABLE BORDER="1" COLOR="#999999" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5">
      <TR><TD COLSPAN="2"><B>Виды связей</B></TD></TR>
      <TR><TD ALIGN="LEFT">——</TD><TD ALIGN="LEFT">ассоциация: актёр участвует в варианте</TD></TR>
      <TR><TD ALIGN="LEFT">——▷</TD><TD ALIGN="LEFT">обобщение: частный случай → общий</TD></TR>
      <TR><TD ALIGN="LEFT">- - -&gt;</TD><TD ALIGN="LEFT">«include»: базовый → включаемый</TD></TR>
      <TR><TD ALIGN="LEFT">- - -&gt;</TD><TD ALIGN="LEFT">«extend» [условие]: расширяющий → базовый</TD></TR>
    </TABLE>>];

  // обобщение актёров (по внешнему краю)
  edge [arrowhead=empty, arrowsize=1.4, style=solid];
  reader -> guest  [label="обобщение"];
  // стрелка останавливается над фигуркой редактора (опорная точка w0)
  w0 [shape=point, width=0.01, pos="17.548,2.72!", class=""];
  admin  -> w0 [label="обобщение"];
  // «Редактор → Читатель» идёт под границей системы через опорные точки w1, w2
  w1 [shape=point, width=0.01, pos="17.548,-1.107!", class=""];
  w2 [shape=point, width=0.01, pos="0.000,-1.107!", class=""];
  editor -> w1 [arrowhead=none];
  w1 -> w2 [arrowhead=none, label="обобщение"];
  w2 -> reader;

  // обобщение вариантов
  g_text -> g_find [label="обобщение"];
  g_filt -> g_find [label="обобщение"];

  // ассоциации
  edge [arrowhead=none, style=solid, label="ассоциация"];
  guest -> g_reg; guest -> g_login; guest -> g_read; guest -> g_time; guest -> g_graph; guest -> g_find;
  reader -> r_com; reader -> r_bm; reader -> r_prof; reader -> r_quiz;
  admin -> a_rev; admin -> a_arch; admin -> a_mod; admin -> a_role; admin -> a_cat; admin -> a_stat;
  editor -> e_edit; editor -> e_send; editor -> e_link; editor -> e_hist;

  // включение и расширение
  edge [arrowhead=vee, arrowsize=1.0, style=dashed];
  e_edit -> e_rev  [label="«include»"];
  e_send -> e_rev  [label="«include»"];
  a_rev  -> a_log  [label="«include»"];
  a_arch -> a_log  [label="«include»"];
  a_why  -> a_rev [label=""];
  // подпись расширения вынесена под стрелку, чтобы не наезжать на эллипс
  why_lbl [shape=plaintext, style="", fixedsize=false, fontsize=10, class="", pos="11.3,8.42!", label="«extend»\n[статья отклонена]"];
  r_save -> r_quiz [label="«extend»\n[пользователь вошёл]"];
}
